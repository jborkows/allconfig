alias nvim202404='NVIM_APPNAME="nvim202404" nvim'
alias githubchoser='bash ~/.scripts/github/githubchoser.sh'
alias updateansible='bash ~/.scripts/update_ansible.sh'
alias addremote='bash ~/.scripts/add_github_remote.sh'
alias ..='cd ..'
alias cd=z
alias cdx=zi
alias hl='rg --passthru'
alias signal='signal-desktop --password-store=kwallet6'
alias tmuux=tmux
alias tmuxx=tmux
alias nvim_swap='cd $HOME/.local/state/nvim/swap'
