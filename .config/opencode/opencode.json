{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["{env:HOME}/.config/opencode/scripts/playwright-mcp.sh"],
      "enabled": true
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "*": "ask",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "*.java": "allow",
      "*.kt": "allow",
      "*.go": "allow",
      "*.rs": "allow"
    },
    "glob": {
      "*": "ask",
      "*.java": "allow",
      "*.kt": "allow",
      "*.ts": "allow",
      "*.go": "allow",
      "*.rs": "allow"
    },
    "bash": {
      "*": "ask",
      "git": "allow",
      "git *": "allow",
      "git commit": "ask",
      "git commit *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git reset": "ask",
      "git reset *": "ask",
      "git push --force": "deny",
      "git push --force *": "deny",
      "git push -f": "deny",
      "git push -f *": "deny",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "ls *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "xxd *": "allow",
      "free *": "allow",
      "uname *": "allow",
      "npm *": "allow",
      "make *": "allow",
      "mvn *": "allow",
      "gradle *": "allow",
      "gradlew *": "allow",
      "java *": "allow",
      "javac *": "allow",
      "echo *": "allow",
      "rm -rf *": "deny",
      "cat *target/*":"allow",
      "date *":"allow",
      "date":"allow"
    },
    "skill": {
      "*": "allow",
      "open-site": "allow"
    },
    "todowrite": "allow"
  }
}
