{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["{env:HOME}/.config/opencode/scripts/playwright-mcp.sh"],
      "enabled": true
    }
  },
  "permission": {
    "*": "ask",
    "git log *": "allow",
    "kubectl get *": "allow",
    "kubectl describe *": "allow",
    "kubectl logs *": "allow",
    "grep *": "allow",
    "ls *": "allow",
    "xxd *": "allow",
    "free *": "allow",
    "uname *": "allow",
    "npm *": "allow",
    "make *": "allow",
    "rm -rf *": "deny",
    "grep *": "allow",
    "skill": {
      "*": "allow",
      "open-site": "allow"
    }
  }
}
